PORT=5000
NODE_ENV=development

# -----------------------------------------------------------------------------
# MONGODB CONNECTION CONFIGURATION (MANDATORY FOR PERSISTENT STORAGE)
# -----------------------------------------------------------------------------
# Option A: MongoDB Atlas (Cloud Hosted - Recommended for Hackathons/Demos)
# Create a free M0 cluster at https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster-subdomain>.mongodb.net/<database_name>?retryWrites=true&w=majority
# Example:
# MONGO_URI=mongodb+srv://aicte_admin:YourStrongPassword123@cluster0.abcde.mongodb.net/aicte-securedeposit?retryWrites=true&w=majority

# Option B: Local MongoDB Server
# Ensure MongoDB Community Server is installed and started on port 27017 (e.g. run 'net start MongoDB' or 'mongod')
MONGO_URI=mongodb://127.0.0.1:27017/aicte-securedeposit

# JWT Authentication
JWT_SECRET=aicte_securedeposit_jwt_secret_key_sih2026_super_secure
JWT_EXPIRES_IN=7d

# Frontend Client URL (CORS allowed origin)
CLIENT_URL=http://localhost:5173

# Email Notifications (Optional SMTP credentials)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=demo_aicte@ethereal.email
EMAIL_PASS=demo_pass
